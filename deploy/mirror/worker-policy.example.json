{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR_SES_MAIL_BUCKET/domain-one/*",
        "arn:aws:s3:::YOUR_SES_MAIL_BUCKET/domain-two/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:123456789012:stalwart-mirror"
    }
  ]
}
