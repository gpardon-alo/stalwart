# On Lightsail: cp .env.production.example .env.production && chmod 600 .env.production
STALWART_PUBLIC_URL=https://mail.taisventures.com
# Initial bootstrap may use this official image. Actions deploys the fork by digest.
STALWART_IMAGE=stalwartlabs/stalwart:v0.16.27
STALWART_ADMIN_PORT=8080
# Dedicated instance defaults. If port 443 belongs to an existing proxy,
# set BIND=127.0.0.1 and PORT=18443, then follow the shared-host guide.
STALWART_HTTPS_BIND=0.0.0.0
STALWART_HTTPS_PORT=443
# SES credentials and Route 53 credentials belong in Stalwart's persistent
# settings or your secret manager, never in Git or workflow output.
